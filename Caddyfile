{
	# TLS уже терминируется выше по цепочке (внешний edge-Caddy на Linode) —
	# этот, внутренний Caddy получает через WireGuard-туннель уже
	# расшифрованный HTTP. Сайт ниже адресован голым ":80" (не доменом)
	# именно поэтому — Caddy не триггерит automatic HTTPS для чистого
	# порт-адреса. auto_https off — доп. страховка на случай, если кто-то
	# позже заменит ":80" на доменное имя: без неё редирект на
	# https://домен прилетает обратно сюда же как HTTP через внешний Caddy,
	# и так по кругу — ERR_TOO_MANY_REDIRECTS у любого клиента, без
	# исключений (было именно так, пока адрес был доменным).
	auto_https off
}

:80 {
	# --- Фаза 1 (доступ только своей команде) — basic auth включён по умолчанию ---
	# Хэш пароля генерируется так (обязательно с `| sed` на конце!):
	#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'ВАШ_ПАРОЛЬ' | sed 's/\$/\$\$/g'
	# Результат (уже с удвоенными $$) — в CADDY_BASIC_AUTH_HASH в .env.
	# Без `sed`-экранирования docker compose съедает всё после первого "$" в
	# значении из .env при подстановке ${CADDY_BASIC_AUTH_HASH} — хэш в
	# контейнере окажется обрублен до 5-6 символов, basicauth не примет ни
	# один пароль, и логин будет выпадать снова и снова у всех. Проверить,
	# что реально долетело до контейнера:
	#   docker exec hvac-guide-caddy printenv CADDY_BASIC_AUTH_HASH
	# (должна быть полная строка ~60 символов, а не обрубок вида "$2a$14").
	basicauth {
		{$CADDY_BASIC_AUTH_USER} {$CADDY_BASIC_AUTH_HASH}
	}
	# --- Фаза 2 (публичный запуск) ---
	# Чтобы отключить basic auth и открыть доступ всем — закомментируйте
	# блок basicauth выше (код приложения трогать не нужно).

	reverse_proxy {$CADDY_UPSTREAM}
}
