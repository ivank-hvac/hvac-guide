{
	# TLS is already terminated further up the chain (an external edge Caddy
	# on Linode) — this, internal Caddy gets already-decrypted HTTP over a
	# WireGuard tunnel. The site below is addressed with a bare ":80" (not a
	# domain) specifically for that reason — Caddy doesn't trigger automatic
	# HTTPS for a plain port address. auto_https off is an extra safety net
	# in case someone later replaces ":80" with a domain name: without it, a
	# redirect to https://domain comes right back here as HTTP through the
	# external Caddy, in a loop — ERR_TOO_MANY_REDIRECTS for every client, no
	# exceptions (this is exactly what happened while the address was a
	# domain name).
	auto_https off

	# The application sits behind two proxies: an edge Caddy on a public host
	# and this one, reached over a WireGuard tunnel. Without this block every
	# request arrives from the tunnel peer, so the app sees one client for the
	# whole internet and its per-client rate limits are meaningless.
	#
	# Only the tunnel peer is trusted. X-Forwarded-For is attacker-controlled
	# up to the point it enters infrastructure we run, so the address is taken
	# from the trusted end of the chain, not from whatever the client sent.
	servers {
		trusted_proxies static 10.0.1.1
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	# The landing page ("/" and the handful of static files it needs) is
	# public — it exists to be read before anyone has a password. Everything
	# else, including the diagnostic tool itself, stays behind basic auth.
	#
	# This list must be kept in sync with the equivalent block on the edge
	# Caddy (Linode) — see CLAUDE.md. A mismatch fails toward "the landing
	# page 401s" rather than a leak, because whichever layer is stricter
	# challenges first — but the two are still supposed to agree.
	#
	# Caddyfile directives compile to routes ordered by Caddy's own directive
	# priority, not by their order in this file — basic_auth always runs
	# before a bare route block regardless of where it's written. @not_public
	# is the inverse match, gating basic_auth itself, rather than trying to
	# out-order it.
	@not_public {
		not path / /style.css /favicon.ico /icon-512.png
	}

	# --- Phase 1 (team-only access) — basic auth enabled by default ---
	# The password hash is generated like this (MUST end with `| sed`!):
	#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR_PASSWORD' | sed 's/\$/\$\$/g'
	# The result (with the doubled $$) goes into CADDY_BASIC_AUTH_HASH in .env.
	# Without `sed`-escaping, docker compose swallows everything after the
	# first "$" in the value from .env when substituting
	# ${CADDY_BASIC_AUTH_HASH} — the hash ends up truncated to 5-6 characters
	# in the container, basic_auth won't accept any password, and the login
	# prompt keeps reappearing for everyone. Check what actually made it into
	# the container:
	#   docker exec hvac-guide-caddy printenv CADDY_BASIC_AUTH_HASH
	# (should be the full ~60-character string, not a stub like "$2a$14").
	# `basic_auth` is the current spelling; Caddy renamed it in 2.8 and warns
	# on every start about the old `basicauth`. Anyone self-hosting on a Caddy
	# older than 2.8 needs the old spelling instead.
	basic_auth @not_public {
		{$CADDY_BASIC_AUTH_USER} {$CADDY_BASIC_AUTH_HASH}
	}
	# --- Phase 2 (public launch) ---
	# To disable basic auth and open access to everyone — comment out the
	# basic_auth block above (no need to touch the application code).

	# Access logging is off by default in Caddy, which means an incident — or
	# a penetration test — leaves no trace at all. JSON to stderr keeps this
	# file free of host-specific paths: `docker compose logs caddy` works for a
	# plain self-host, and a deployment that ships logs elsewhere can collect
	# them from the container's log file without extra volumes.
	#
	# Request headers are NOT logged: the Authorization header would otherwise
	# put basic-auth credentials in plain text into every single log line.
	log {
		output stderr
		format json
	}

	reverse_proxy {$CADDY_UPSTREAM} {
		# Resolved by Caddy against trusted_proxies above, so the application
		# receives one header it can rely on instead of parsing a chain and
		# having to decide which element is not forged.
		header_up X-Real-IP {client_ip}
	}
}
