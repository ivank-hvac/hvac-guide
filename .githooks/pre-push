#!/usr/bin/env bash
# Blocks a push if app/static/content/<lang>.json has drifted out of sync
# with app/static/graph-structure.json (a $text path missing on one side,
# or a stale one left on the other) — see tools/validate_content.py.
# graph.json (the built artifact) is validated too: it must still exist and
# be a real JSON file, since that's what the app actually serves.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if [ ! -f app/graph_src/graph-structure.json ]; then
  # Pre-split repo state (or a machine that hasn't pulled the split yet) —
  # nothing to validate.
  exit 0
fi

python3 tools/validate_content.py
