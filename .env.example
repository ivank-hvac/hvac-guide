# Copy this file to .env and fill it in
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# Only needed with docker-compose.bitwarden.yml (optional override, not
# part of the plain self-host path above) — the Bitwarden Secrets Manager
# project ID that `bws run` fetches ANTHROPIC_API_KEY from at container
# start, instead of the value above. See CLAUDE.md "Секреты: переход на
# Bitwarden Secrets Manager".
BWS_PROJECT_ID=
BWS_ACCESS_TOKEN=

# How many requests to /api/ai-assist a single IP is allowed per minute.
# Tighten this when going public (e.g. 3/minute).
AI_ASSIST_RATE_LIMIT=8/minute

# Cap on the model's response length for a plain one-shot AI ask (no intake
# checklist context). Bumped from the code's conservative fallback default
# (2048) — that was cutting deeper analyses short mid-sentence.
AI_ASSIST_MAX_TOKENS=4096

# Higher max_tokens ceiling used only for the AI request made after a
# technician has gone through the intake checklist (see
# app.js/state.intakeAsked) — that pass has richer context worth paying
# extra tokens for, so this stays above AI_ASSIST_MAX_TOKENS above.
AI_DEEP_DIVE_MAX_TOKENS=6000

# How many checklist-history log writes (/api/log-session) a single IP is
# allowed per minute. The Anthropic API isn't called; this only protects the
# database from spam.
LOG_SESSION_RATE_LIMIT=30/minute

# How many resumable-session save/restore calls (/api/session) a single IP
# is allowed per minute. Separate from LOG_SESSION_RATE_LIMIT above: this one
# fires on every debounced save while a checklist is in progress (not just
# once at the end), so it needs more headroom.
SESSION_RATE_LIMIT=20/minute

# Enables the hidden dev-only stats dashboard at GET /panel?token=... (see
# README "Dev monitoring panel"). Blank by default — /panel responds with a
# plain 404 (not an error page) until this is set, so an unconfigured deploy
# doesn't hint the route exists. Same silent-404 behavior if this literally
# still says "<token>" (i.e. you pasted this comment's own example instead
# of generating a real value) or contains anything other than letters/digits.
# Generate a real one with: openssl rand -hex 16
MONITOR_PANEL_TOKEN=

# --- Only for docker-compose.prod.yml (deploy with Caddy) ---
# Basic auth for Phase 1 (see Caddyfile). Leave blank once you open access to
# everyone — just comment out the basicauth block in Caddyfile.
# IMPORTANT: generate the hash with `| sed 's/\$/\$\$/g'` on the end (see
# Caddyfile/README) — otherwise docker compose truncates the hash at the
# first "$" and basic auth won't accept any password.
CADDY_BASIC_AUTH_USER=crew
CADDY_BASIC_AUTH_HASH=

# Where Caddy proxies requests to (docker-compose service:port). Only change
# this if you renamed the hvac-guide service in docker-compose.prod.yml —
# leave the default for normal use.
CADDY_UPSTREAM=hvac-guide:8000

# Don't fill these in by hand: GIT_COMMIT / GIT_COMMIT_DATE will appear here
# on their own after `git config core.hooksPath .githooks` (once per clone)
# — a hook updates them on every commit/checkout, and docker-compose passes
# them into the image as build args. See README "Build version".

# Daily ceilings on assistant usage. Rate limiting caps requests per minute;
# these cap the day, which is what actually bounds the bill. The per-session
# figure is the one a technician sees counting down in the interface. Keep the
# global figure below the provider's own spend limit so this fails first, with
# an explanation, instead of the provider failing opaquely.
AI_DAILY_LIMIT_PER_SESSION=100
AI_DAILY_LIMIT_GLOBAL=400
