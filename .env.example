# Скопируйте этот файл в .env и заполните
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# Сколько запросов к /api/ai-assist разрешено с одного IP в минуту.
# Ужесточите при переходе в публичную фазу (например 3/minute).
AI_ASSIST_RATE_LIMIT=8/minute

# Сколько записей истории чек-листов (/api/log-session) разрешено с одного
# IP в минуту. Anthropic API не вызывается, лимит только защищает базу от спама.
LOG_SESSION_RATE_LIMIT=30/minute

# --- Только для docker-compose.prod.yml (деплой с Caddy) ---
# Домен, на который смотрит DNS этой машины. Пусто/localhost — без реального TLS.
DOMAIN=hvac.example.com

# Basic auth на фазу 1 (см. Caddyfile). Оставьте пустыми, когда откроете
# доступ всем — просто закомментируйте блок basicauth в Caddyfile.
CADDY_BASIC_AUTH_USER=crew
CADDY_BASIC_AUTH_HASH=

# Не заполняйте вручную: GIT_COMMIT / GIT_COMMIT_DATE появятся здесь сами
# после `git config core.hooksPath .githooks` (один раз на клон) — хук
# обновляет их при каждом commit/checkout, docker-compose передаёт их как
# build args в образ. См. README "Версия сборки".
