# Dev-only variant of Caddyfile, swapped in by docker-compose.dev-prod-mirror.yml.
# Identical to the real Caddyfile except the basic_auth block is gone — the
# invite-gate feature (see app/main.py, AUTH_ENABLED) needs to be reachable
# by an unauthenticated visitor with just an invite link, and basic auth in
# front of it defeats that on the dev stand where it's actually being tested.
# Prod keeps basic auth until invite-gate is confirmed as the sole path in
# (see CLAUDE.md "план выхода в паблик") — this file is what changes there
# without touching the real Caddyfile everyone else deploys with.
{
	auto_https off

	servers {
		trusted_proxies static {$CADDY_TRUSTED_PROXY}
		client_ip_headers X-Forwarded-For
	}
}

:80 {
	log {
		output stderr
		format json
	}

	reverse_proxy {$CADDY_UPSTREAM} {
		header_up X-Real-IP {client_ip}
	}
}
